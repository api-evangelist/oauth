          "request": {
            "name": "Authorization Endpoint",
            "description": {
              "content": "The authorization endpoint is used to interact with the resource owner and obtain an authorization grant. The authorization server MUST first verify the identity of the resource owner.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) The value MUST be \"code\" for requesting an authorization code or \"token\" for requesting an access token (implicit grant)."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The client identifier issued to the client during registration."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "The URI to which the authorization server will redirect the user-agent after authorization is granted or denied."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "The scope of the access request as a space-delimited list of values."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "An opaque value used by the client to maintain state between the request and callback. Used to prevent cross-site request forgery."
                }
              ],
              "variable": []
