              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) The value MUST be \"code\" for requesting an authorization code or \"token\" for requesting an access token (implicit grant)."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The client identifier issued to the client during registration."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "The URI to which the authorization server will redirect the user-agent after authorization is granted or denied."
