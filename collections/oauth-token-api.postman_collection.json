          "request": {
            "name": "Token Endpoint",
            "description": {
              "content": "The token endpoint is used by the client to obtain an access token by presenting its authorization grant or refresh token. Supports authorization code, client credentials, resource owner password credentials, and refresh token grant types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The type of grant being presented."
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "The authorization code received from the authorization server. Required for authorization_code grant type."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "The redirect URI used in the authorization request. Required if included in the original authorization request."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "The client identifier. Required for public clients not authenticating via other means."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "The client secret. Used for confidential clients authenticating via POST body."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "The scope of the access request as a space-delimited list."
                },
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "The resource owner username. Required for password grant type."
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<string>",
